# DOCUMENTATION ONLY: do not overwrite the existing /etc/portra-integration/app.env.
# Root edits the actual EnvironmentFile (600 root:root); do not source it as shell code.
# Empty values are intentional blockers. Never paste real values into this repository/chat.
SPRING_DATASOURCE_PASSWORD=
JWT_SECRET=
PHONE_ENCRYPTION_KEY=
PHONE_LOOKUP_HMAC_KEY=
SMS_CODE_PEPPER=
SMS_PROVIDER=dypns
SMS_STAGING_DYPNS_ENABLED=true
SMS_STAGING_ALIYUN_ENABLED=false
SMS_DYPNS_ROLE_NAME=PortraSmsEcsRole
SMS_DYPNS_ENDPOINT=dypnsapi.aliyuncs.com
SMS_SIGN_NAME=恒创联众
SMS_LOGIN_TEMPLATE_ID=100001
# Select an approved template suitable for sensitive-operation verification; same ID is allowed.
SMS_REAUTH_TEMPLATE_ID=
SMS_REAUTH_SCHEME_NAME=默认方案
SMS_CODE_TTL=5m
SMS_RESEND_COOLDOWN=60s
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Non-secret operator attestations, set only after checking independent configuration.
PORTRA_INDEPENDENT_KEYS_REVIEWED=
PORTRA_PNVS_RAM_ROLE_REVIEWED=
PORTRA_PRIVACY_VERSION_REVIEWED=
PORTRA_SMTP_REVIEWED=
