+          .fontWeight(FontWeight.Bold)
+      }
+      .width('100%')
+      .padding(PortraTheme.spacingLg)
+      if (this.loading) {
+        PortraLoading({ label: '正在读取用户主页' })
+      } else {
+        Scroll() {
