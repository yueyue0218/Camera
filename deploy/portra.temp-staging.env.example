# Canonical non-secret template for /etc/portra/portra.env on temporary staging.
# Never commit the populated server file or replace REPLACE_ME with real values here.
SPRING_PROFILES_ACTIVE=temp-staging
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/portra_staging?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=portra_app
SPRING_DATASOURCE_PASSWORD=REPLACE_ME
JWT_SECRET=REPLACE_ME
PORT=8080
FILE_STORAGE_LOCAL_PATH=/opt/portra/uploads
CAMERA_ORDER_ADAPTER=local
TEMP_STAGING_ALLOWED_ORIGIN=https://47.76.106.57
TEMP_STAGING_ALLOWED_TEST_USER_IDS=REPLACE_ME
