# Required production process environment. Do not put real values in Git.
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/camera_app?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=camera_app
SPRING_DATASOURCE_PASSWORD=
SPRING_MAIL_HOST=smtp.qq.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
SESSION_REFRESH_COOKIE_NAME=camera_refresh
SESSION_REFRESH_TTL_DAYS=30
SMS_PROVIDER=aliyun
SMS_ENDPOINT=dysmsapi.aliyuncs.com
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_LOGIN_TEMPLATE_ID=
SMS_CODE_PEPPER=
PHONE_ENCRYPTION_KEY=
PHONE_LOOKUP_HMAC_KEY=

# Generate a different SMS code pepper for each environment. Never print it.
# openssl rand -base64 48

# Generate a fresh JWT secret for each environment, for example:
# openssl rand -base64 48
# CAMERA_DEMO_BYPASS_CODE must never be set in production.
